#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
QEMU="$(command -v qemu-aarch64 || command -v qemu-aarch64-static || true)"
run_a64(){ [[ -n "${QEMU}" ]] || { echo "need qemu-aarch64" >&2; exit 1; }; "${QEMU}" "$@"; }
usage(){ cat <<'U'
shareblip — masked ML-KEM AArch64 lab + HO-SCA board sim

  help | version | build | test | sim | sim-quick | check | asmcheck

  ./scripts/shareblip check
  ./scripts/shareblip sim --traces 200 --noise 0.2
U
}
cmd="${1:-help}"; shift || true
case "$cmd" in
  help|-h|--help) usage ;;
  version) echo "shareblip 0.1.0" ;;
  build) make -C "$ROOT" all ;;
  test) make -C "$ROOT" test ;;
  asmcheck) make -C "$ROOT" asmcheck ;;
  sim) make -C "$ROOT" sim/board/board_sim; run_a64 "$ROOT/sim/board/board_sim" "$@" ;;
  sim-quick) make -C "$ROOT" sim/board/board_sim; run_a64 "$ROOT/sim/board/board_sim" --traces 32 --noise 0.5 ;;
  check)
    make -C "$ROOT" all test
    make -C "$ROOT" sim/board/board_sim
    run_a64 "$ROOT/sim/board/board_sim" --traces 64 --noise 0.25
    echo "shareblip check OK"
    ;;
  *) usage; exit 1 ;;
esac
